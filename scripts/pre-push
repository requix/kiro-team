#!/bin/bash
# Pre-push hook: runs the same checks as CI
# Install with: ./scripts/install-hooks.sh

set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

echo "Running pre-push checks..."

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Run the comprehensive agent validation (L1-L2)
echo ""
echo "Running agent validation..."
if ! bash "$SCRIPT_DIR/validate-agents.sh"; then
    echo -e "${RED}✗ Agent validation failed${NC}"
    echo ""
    echo "Fix the issues above before pushing."
    echo "For semantic (L3+) validation, run: @validate-agents"
    exit 1
fi

echo ""
echo -e "${GREEN}All pre-push checks passed${NC}"
